/* ---------------- Customize modal ---------------- */
function startCustomize(restId, dishId){
  const restaurant = findRestaurant(restId);
  const dish = restaurant.dishes.find(d => d.id === dishId);
  modalCtx = {
    restaurant, dish,
    sizeId: dish.sizes ? dish.sizes[0].id : null, swapId: dish.swap ? dish.swap[0].id : null, removeIds: new Set(),
    extraIds: new Set(),
    notes:'',
    qty:1
  };
  renderModal();
  document.getElementById('customizeOverlay').classList.add('open');
}

function closeModal(){
  document.getElementById('customizeOverlay').classList.remove('open');
  modalCtx = null;
}

function modalUnitPrice(){
  const { dish, sizeId, extraIds } = modalCtx;
  let p = dish.price;
  if (dish.sizes){ p += dish.sizes.find(s => s.id === sizeId).delta; }
  if (dish.swap){ p += dish.swap.find(s => s.id === modalCtx.swapId).delta; }
  if (dish.extras){ dish.extras.forEach(e => { if (extraIds.has(e.id)) p += e.delta; }); }
  return p;
}

function renderModal(){
  const { restaurant, dish, sizeId, extraIds, qty } = modalCtx;
  const unit = modalUnitPrice();
  document.getElementById('customizeModal').innerHTML = `
    <button class="modal-close" onclick="closeModal()">✕</button>
    <div class="modal-head">
      <div class="modal-rest">${restaurant.name}</div>
      <h3>${dish.name}</h3>
      <p class="dish-desc">${dish.desc}</p>
    </div>
    <div class="modal-body">
      ${dish.sizes ? `
        <div class="opt-group">
          <div class="opt-title">Tamaño / presentación</div>
          ${dish.sizes.map(s => `
            <div class="opt-row ${sizeId===s.id?'selected':''}" onclick="pickSize('${s.id}')">
              <div class="opt-row-left">
                <span class="opt-mark round ${sizeId===s.id?'on':''}"></span>
                <span>${s.label}</span>
              </div>
              <span class="opt-delta">${s.delta===0?'incluido':(s.delta>0?'+':'')+money(s.delta)}</span>
            </div>
          `).join('')}
        </div>
      ` : ''}
      ${dish.swap ? `
        <div class="opt-group">
          <div class="opt-title">Cambiar acompañamiento <span class="opt-hint">(opcional)</span></div>
          ${dish.swap.map(o => `<div class="opt-row ${modalCtx.swapId===o.id?'selected':''}" onclick="modalCtx.swapId='${o.id}';renderModal()"><div class="opt-row-left"><span class="opt-mark round ${modalCtx.swapId===o.id?'on':''}"></span><span>${o.label}</span></div><span class="opt-delta">${o.delta===0?'sin costo':'+'+money(o.delta)}</span></div>`).join('')}
        </div>` : ''}
      ${dish.remove ? `
        <div class="opt-group">
          <div class="opt-title">Quitar ingredientes <span class="opt-hint">(opcional, sin costo)</span></div>
          ${dish.remove.map((o,i) => `<div class="opt-row ${modalCtx.removeIds.has(i)?'selected':''}" onclick="toggleRemove(${i})"><div class="opt-row-left"><span class="opt-mark square ${modalCtx.removeIds.has(i)?'on':''}"></span><span>Sin ${o.toLowerCase()}</span></div></div>`).join('')}
        </div>` : ''}
      ${dish.extras ? `
        <div class="opt-group">
          <div class="opt-title">Agregar algo más <span class="opt-hint">(opcional)</span></div>
          ${dish.extras.map(e => `
            <div class="opt-row ${extraIds.has(e.id)?'selected':''}" onclick="toggleExtra('${e.id}')">
              <div class="opt-row-left">
                <span class="opt-mark square ${extraIds.has(e.id)?'on':''}"></span>
                <span>${e.label}</span>
              </div>
              <span class="opt-delta">${e.delta===0?'sin costo':'+'+money(e.delta)}</span>
            </div>
          `).join('')}
        </div>
      ` : ''}
      <div class="opt-group">
        <div class="opt-title">Instrucciones especiales <span class="opt-hint">(opcional)</span></div>
        <textarea class="notes" placeholder="Ej: sin cebolla, poco picante, salsa aparte..." oninput="modalCtx.notes=this.value">${modalCtx.notes}</textarea>
      </div>
      <div class="opt-group">
        <div class="opt-title">Cantidad</div>
        <div class="qty-row">
          <div class="stepper">
            <button class="step-btn" onclick="changeQty(-1)">–</button>
            <span class="step-val">${qty}</span>
            <button class="step-btn" onclick="changeQty(1)">+</button>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn-primary" onclick="confirmAddToCart()">
        <span>Agregar al pedido</span>
        <span>${money(unit * qty)}</span>
      </button>
    </div>
  `;
}

function toggleRemove(i){ const r=modalCtx.removeIds; if(r.has(i)) r.delete(i); else r.add(i); renderModal(); }
function pickSize(id){ modalCtx.sizeId = id; renderModal(); }
function toggleExtra(id){
  if (modalCtx.extraIds.has(id)) modalCtx.extraIds.delete(id); else modalCtx.extraIds.add(id);
  renderModal();
}
function changeQty(d){
  modalCtx.qty = Math.max(1, modalCtx.qty + d);
  renderModal();
}

function quickAdd(restId, dishId){
  const restaurant = findRestaurant(restId);
  const dish = restaurant.dishes.find(d => d.id === dishId);
  const ctx = {
    restaurant, dish,
    sizeId: dish.sizes ? dish.sizes[0].id : null, swapId: dish.swap ? dish.swap[0].id : null, removeIds: new Set(),
    extraIds: new Set(),
    notes:'',
    qty:1
  };
  tryAddToCart(ctx);
}

function confirmAddToCart(){
  tryAddToCart(modalCtx);
}

function tryAddToCart(ctx){
  const otherRestInCart = cart.find(i => i.restaurantId !== ctx.restaurant.id);
  if (otherRestInCart){
    pendingSwitch = ctx;
    document.getElementById('switchTitle').textContent = 'Ya tienes platos de ' + otherRestInCart.restaurantName;
    document.getElementById('switchBody').textContent = 'Por ahora solo puedes pedir de un restaurante a la vez. ¿Vaciamos tu pedido actual para agregar platos de ' + ctx.restaurant.name + '?';
    document.getElementById('switchOverlay').classList.add('open');
    return;
  }
  addCtxToCart(ctx);
}

function addCtxToCart(ctx){
  const { restaurant, dish, sizeId, extraIds, notes, qty } = ctx;
  const sizeObj = dish.sizes ? dish.sizes.find(s => s.id === sizeId) : null;
  const extrasChosen = (dish.extras || []).filter(e => extraIds.has(e.id));
  let unit = dish.price;
  if (sizeObj) unit += sizeObj.delta;
  if (dish.swap) unit += dish.swap.find(o => o.id === ctx.swapId).delta;
  extrasChosen.forEach(e => unit += e.delta);
  cart.push({
    cartId: uid(),
    restaurantId: restaurant.id,
    restaurantName: restaurant.name,
    dishName: dish.name,
    sizeLabel: sizeObj ? sizeObj.label : null,
    swapLabel: dish.swap ? dish.swap.find(o => o.id === ctx.swapId).label : null,
    removed: (dish.remove || []).filter((_,i) => ctx.removeIds.has(i)),
    extras: extrasChosen.map(e => ({label:e.label, delta:e.delta})),
    notes: notes.trim(),
    qty,
    unitPrice: unit
  });
  if (document.getElementById('customizeOverlay').classList.contains('open')) closeModal();
  selectedPickupId = null;
  updateCartBadge();
  openCart();
}

/* ---------------- Restaurant switch confirm ---------------- */
function closeSwitch(){
  document.getElementById('switchOverlay').classList.remove('open');
  pendingSwitch = null;
}
function confirmSwitch(){
  cart = [];
  const ctx = pendingSwitch;
  pendingSwitch = null;
  document.getElementById('switchOverlay').classList.remove('open');
  addCtxToCart(ctx);
}

/* ---------------- Cart drawer ---------------- */
function updateCartBadge(){
  document.getElementById('cartCount').textContent = cart.reduce((s,i) => s + i.qty, 0);
}

function openCart(){
  confirmedOrder = null;
  renderCart();
  document.getElementById('drawer').classList.add('open');
  document.getElementById('drawerOverlay').classList.add('open');
}
function closeCart(){
  document.getElementById('drawer').classList.remove('open');
  document.getElementById('drawerOverlay').classList.remove('open');
}

function cartLineTotal(item){ return item.unitPrice * item.qty; }
function cartSubtotal(){ return cart.reduce((s,i) => s + cartLineTotal(i), 0); }

