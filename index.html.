function parseOpts(t,p){ return (t||'').split(',').map(x=>x.trim()).filter(Boolean).map((x,i)=>{ const [l,d]=x.split('='); return {id:p+i, label:l.trim(), delta:parseFloat(d)||0}; }); }

const money = n => 'S/ ' + n.toFixed(2);
const uid = () => Math.random().toString(36).slice(2,10);

function findRestaurant(id){ return RESTAURANTS.find(r => r.id === id); }

