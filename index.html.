      <div class="opt-row ${selectedPickupId===p.id?'selected':''}" onclick="pickPickup('${p.id}')">
        <div class="opt-row-left">
          <span class="opt-mark round ${selectedPickupId===p.id?'on':''}"></span>
          <span>${p.label}</span>
        </div>
      </div>
    `).join('')}
    <div class="opt-title" style="margin:14px 0 8px;">Método de pago</div>
    <div class="pay-row">${PAYS.map(p => `<button class="pay-chip ${selectedPay===p?'on':''}" onclick="selectedPay='${p}';renderCart()">${p}</button>`).join('')}</div>
    <div class="totals-row grand" style="margin-top:14px;"><span>Total a pagar</span><span>${money(subtotal)}</span></div>
    <button class="btn-primary" style="margin-top:14px;" onclick="checkout(${subtotal})">
      <span style="width:100%; text-align:center;">Confirmar pedido</span>
    </button>
  `;
}

function pickPickup(id){ selectedPickupId = id; renderCart(); }

function cartQty(cartId, d){
  const item = cart.find(i => i.cartId === cartId);
  item.qty = Math.max(1, item.qty + d);
  renderCart();
  updateCartBadge();
}
function removeFromCart(cartId){
  cart = cart.filter(i => i.cartId !== cartId);
  if (cart.length === 0) selectedPickupId = null;
  renderCart();
  updateCartBadge();
}

function checkout(total){
  const restaurant = findRestaurant(cart[0].restaurantId);
  const pickup = restaurant.pickupPoints.find(p => p.id === selectedPickupId);
  orders.push({ id: orders.length + 1, restaurantId: restaurant.id, restaurantName: restaurant.name, items: cart, total, pickupLabel: pickup.label, pay: selectedPay, status: 0 });
  confirmedOrder = { restaurantName: restaurant.name, total, pickupLabel: pickup.label, pay: selectedPay };
  cart = [];
  selectedPickupId = null;
  updateCartBadge();
  renderCart();
}
function resetAfterOrder(){
  confirmedOrder = null;
  closeCart();
}

/* ---------------- Panel del restaurante ---------------- */
function openPanel(){ panelMode = true; currentRestaurantId = null; render(); window.scrollTo({top:0}); }
function itemLines(i){ return [i.sizeLabel, i.swapLabel && 'Acompañamiento: ' + i.swapLabel, i.removed.length && 'SIN: ' + i.removed.join(', '), i.extras.length && 'EXTRAS: ' + i.extras.map(e => e.label).join(', '), i.notes && 'Nota: "' + i.notes + '"'].filter(Boolean).join(' · '); }
function ordersHtml(){
  if (!orders.length) return '';
  return '<div style="padding:10px 0"><div class="opt-title">Mis pedidos</div>' + orders.slice().reverse().map(o => `<div class="order-card">#${o.id} · ${o.restaurantName} · ${money(o.total)}<br><span class="pill s${o.status}">${STATUS[o.status]}</span> <small>Recojo: ${o.pickupLabel}</small></div>`).join('') + '</div>';
}
function advance(id){ const o = orders.find(x => x.id === id); o.status = Math.min(2, o.status + 1); render(); }
function addDish(){
  const v = id => document.getElementById(id).value.trim();
  const price = parseFloat(v('d-price'));
  if (!v('d-name') || isNaN(price)) return;
  const r = findRestaurant(managedId), swap = parseOpts(v('d-swap'),'s'), extras = parseOpts(v('d-extras'),'e');
  r.dishes.push({ id:'d'+uid(), cat:v('d-cat'), name:v('d-name'), desc:v('d-desc'), price,
    remove: v('d-remove') ? v('d-remove').split(',').map(x => x.trim()).filter(Boolean) : undefined,
    swap: swap.length ? swap : undefined, extras: extras.length ? extras : undefined });
  render();
}
function registerRestaurant(){
  const v = id => document.getElementById(id).value.trim();
  if (!v('r-name') || !v('r-addr')) return;
  const r = { id:'r'+uid(), name:v('r-name'), cuisine:v('r-cuisine'), rating:'Nuevo', time:'20-30 min', pickupPoints:[{id:'p1', label:v('r-addr')}], dishes:[] };
  RESTAURANTS.push(r); managedId = r.id; render();
}
function renderPanel(){
  const r = findRestaurant(managedId), mine = orders.filter(o => o.restaurantId === r.id);
  const gross = mine.reduce((s,o) => s + o.total, 0), fee = gross * 0.12;
  return `
  <section class="rest-banner"><div class="wrap">
    <button class="back-link" onclick="goHome()">‹ Volver al inicio</button>
    <h2>Panel del restaurante</h2>
    <p style="color:var(--chalk-soft);font-size:14.5px;margin:8px 0 0;max-width:560px">Publica tu menú, define qué se puede modificar y cuánto cuesta cada extra, y recibe las órdenes con los cambios claramente indicados.</p>
  </div></section>
  <section class="section"><div class="wrap">
    <label class="fld">Administrando<select class="sel" onchange="managedId=this.value;render()">${RESTAURANTS.map(x => `<option value="${x.id}" ${x.id===managedId?'selected':''}>${x.name}</option>`).join('')}</select></label>
    <div class="panel-box"><h3>Pedidos recibidos</h3>
      <div class="sum-grid"><div>Ventas<b>${money(gross)}</b></div><div>Comisión MenuFlex (12%)<b>${money(fee)}</b></div><div>Tú recibes<b>${money(gross - fee)}</b></div></div>
      ${mine.length ? mine.slice().reverse().map(o => `<div class="order-card"><b>Pedido #${o.id}</b> · ${money(o.total)} · pago ${o.pay}<br>${o.items.map(i => `<div>${i.qty}× <b>${i.dishName}</b>${itemLines(i) ? '<br><small>' + itemLines(i) + '</small>' : ''}</div>`).join('')}<small>Recojo: ${o.pickupLabel}</small><br>
        <span class="pill s${o.status}">${STATUS[o.status]}</span> ${o.status < 2 ? `<button class="btn-plain" onclick="advance(${o.id})">Marcar como ${STATUS[o.status+1].toLowerCase()}</button>` : ''}</div>`).join('') : '<p style="color:var(--ink-soft);font-size:14px;margin:0">Aún no hay pedidos. Haz uno desde la vista de clientes para probar el flujo.</p>'}
    </div>
    <div class="panel-box"><h3>Agregar un plato a ${r.name}</h3>
      <div class="two"><label class="fld">Nombre<input id="d-name"></label><label class="fld">Precio (S/)<input id="d-price" type="number" step="0.5"></label></div>
      <label class="fld">Descripción<input id="d-desc"></label>
      <label class="fld">Categoría<select id="d-cat"><option>Platos fuertes</option><option>Entradas</option><option>Bebidas</option></select></label>
      <label class="fld">Ingredientes que el cliente puede quitar <small>(separados por coma)</small><input id="d-remove" placeholder="Cebolla, Tomate"></label>
      <label class="fld">Cambios de acompañamiento <small>(nombre=costo; el primero viene por defecto)</small><input id="d-swap" placeholder="Arroz=0, Papas fritas=0, Ensalada=1.5"></label>
      <label class="fld">Extras con su precio <small>(nombre=costo)</small><input id="d-extras" placeholder="Palta=3, Huevo=2, Porción extra=5"></label>
      <button class="btn-primary" style="max-width:260px" onclick="addDish()"><span style="width:100%;text-align:center">Publicar plato</span></button>
    </div>
    <div class="panel-box"><h3>Registrar un restaurante nuevo</h3>
      <div class="two"><label class="fld">Nombre<input id="r-name"></label><label class="fld">Tipo de cocina<select id="r-cuisine">${Object.keys(CUISINE_COLORS).map(c => `<option>${c}</option>`).join('')}</select></label></div>
      <label class="fld">Punto de recojo (dirección)<input id="r-addr"></label>
      <button class="btn-primary" style="max-width:260px" onclick="registerRestaurant()"><span style="width:100%;text-align:center">Registrar restaurante</span></button>
    </div>
  </div></section>`;
}

/* ---------------- Init ---------------- */
render();
</script>
</body>
</html>
