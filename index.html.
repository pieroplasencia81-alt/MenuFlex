<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MenuFlex — tu menú, a tu manera</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-paper: #F1E8D3;
    --bg-card: #FBF6EA;
    --bg-dark: #1B2A22;
    --bg-dark-2: #24382C;
    --ink: #241C10;
    --ink-soft: #5B5040;
    --chalk: #F3EFE4;
    --chalk-soft: #C9CDBE;
    --chili: #C1401F;
    --chili-dark: #8F2E14;
    --mustard: #D98F1F;
    --line: rgba(36,28,16,0.16);
    --line-dark: rgba(243,239,228,0.16);
    --radius: 4px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg-paper);
    color:var(--ink);
    font-family:'Public Sans', sans-serif;
    font-size:16px;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{
    font-family:'Bricolage Grotesque', sans-serif;
    font-weight:700;
    letter-spacing:-0.01em;
    margin:0;
    color:inherit;
  }
  button{font-family:inherit;cursor:pointer;}
  a{color:inherit;}
  ::selection{background:var(--mustard); color:var(--ink);}

  /* ---------- Layout shell ---------- */
  .wrap{max-width:1080px; margin:0 auto; padding:0 28px;}
  @media (max-width:640px){ .wrap{padding:0 18px;} }

  header.topbar{
    background:var(--bg-dark);
    color:var(--chalk);
    border-bottom:1px solid var(--line-dark);
  }
  .topbar-inner{
    display:flex; align-items:center; justify-content:space-between;
    padding:18px 0;
  }
  .logo{
    display:flex; align-items:baseline; gap:9px; cursor:pointer;
  }
  .logo .display{font-size:22px; color:var(--chalk);}
  .logo span.tag{font-size:12.5px; color:var(--chalk-soft); font-style:italic;}
  .cart-btn{
    background:transparent;
    border:1px solid var(--line-dark);
    color:var(--chalk);
    padding:9px 16px;
    border-radius:999px;
    font-size:14.5px;
    font-weight:600;
    display:flex; align-items:center; gap:8px;
    transition:border-color .15s ease, background .15s ease;
  }
  .cart-btn:hover{ border-color:var(--mustard); }
  .cart-badge{
    background:var(--chili);
    color:var(--chalk);
    border-radius:999px;
    min-width:20px; height:20px;
    display:inline-flex; align-items:center; justify-content:center;
    font-size:11.5px; font-weight:700; padding:0 5px;
  }

  /* ---------- Hero ---------- */
  .hero{
    background:
      radial-gradient(ellipse 70% 90% at 85% -10%, rgba(217,143,31,0.16), transparent 60%),
      var(--bg-dark);
    color:var(--chalk);
    padding:56px 0 40px;
    border-bottom:1px solid var(--line-dark);
  }
  .hero h1{
    font-size:44px;
    max-width:620px;
    line-height:1.08;
  }
  .hero p.lead{
    max-width:480px;
    color:var(--chalk-soft);
    font-size:16.5px;
    margin-top:16px;
  }
  @media (max-width:640px){ .hero h1{font-size:32px;} }

  .chips{
    display:flex; flex-wrap:wrap; gap:9px;
    margin-top:28px;
  }
  .chip{
    background:transparent;
    border:1px solid var(--line-dark);
    color:var(--chalk-soft);
    padding:8px 15px;
    border-radius:999px;
    font-size:14px;
    font-weight:500;
    transition:all .15s ease;
  }
  .chip.active, .chip:hover{
    border-color:var(--mustard);
    color:var(--chalk);
    background:rgba(217,143,31,0.12);
  }

  /* ---------- Restaurant stalls ---------- */
  .section{ padding:40px 0; }
  .section-head{
    display:flex; align-items:baseline; justify-content:space-between;
    margin-bottom:20px;
  }
  .section-head h2{ font-size:23px; }
  .section-head .count{ font-size:13.5px; color:var(--ink-soft); }

  .stall-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(230px, 1fr));
    gap:16px;
  }
  .stall-card{
    background:var(--bg-card);
    border:1px solid var(--line);
    border-left:4px solid var(--cuisine-color, var(--chili));
    border-radius:2px;
    padding:18px 18px 16px;
    text-align:left;
    display:flex; flex-direction:column; gap:10px;
    transition:transform .12s ease, border-color .12s ease;
  }
  .stall-card:hover{ transform:translateY(-2px); }
  .stall-top{ display:flex; align-items:center; gap:12px; }
  .stall-mono{
    width:42px; height:42px; border-radius:50%;
    background:var(--cuisine-color, var(--chili));
    color:var(--chalk);
    display:flex; align-items:center; justify-content:center;
    font-family:'Bricolage Grotesque', sans-serif;
    font-weight:700; font-size:17px;
    flex-shrink:0;
  }
  .stall-name{ font-family:'Bricolage Grotesque', sans-serif; font-weight:600; font-size:17px; }
  .stall-cuisine{ font-size:13px; color:var(--ink-soft); margin-top:1px;}
  .stall-meta{
    display:flex; gap:14px; font-size:13px; color:var(--ink-soft);
    border-top:1px solid var(--line); padding-top:10px;
  }
  .stall-meta b{ color:var(--ink); font-weight:600; }

  /* ---------- Restaurant detail ---------- */
  .rest-banner{
    background:var(--bg-dark-2);
    color:var(--chalk);
    padding:30px 0 26px;
    border-bottom:1px solid var(--line-dark);
  }
  .back-link{
    background:none; border:none; color:var(--chalk-soft);
    font-size:13.5px; font-weight:600; padding:0; margin-bottom:14px;
    display:inline-flex; align-items:center; gap:6px;
  }
  .back-link:hover{ color:var(--mustard); }
  .rest-banner-row{ display:flex; align-items:center; gap:16px; }
  .rest-banner h2{ font-size:28px; }
  .rest-banner .stall-meta{ border-top:none; padding-top:6px; color:var(--chalk-soft); }
  .rest-banner .stall-meta b{ color:var(--chalk); }

  .cat-label{
    font-size:13.5px; font-weight:700; color:var(--chili-dark);
    text-transform:uppercase; letter-spacing:.05em;
    margin:26px 0 12px;
  }
  .cat-label:first-child{ margin-top:0; }

  .dish-list{ display:flex; flex-direction:column; }
  .dish-row{
    display:flex; justify-content:space-between; gap:18px;
    padding:18px 0;
    border-bottom:1px solid var(--line);
  }
  .dish-row:last-child{ border-bottom:none; }
  .dish-info{ flex:1; min-width:0; }
  .dish-name{ font-family:'Bricolage Grotesque', sans-serif; font-weight:600; font-size:17px; }
  .dish-desc{ font-size:14px; color:var(--ink-soft); margin-top:4px; max-width:480px; }
  .dish-price{ font-size:14.5px; font-weight:700; color:var(--chili-dark); margin-top:8px; }
  .dish-action{ flex-shrink:0; align-self:center; display:flex; align-items:center; gap:10px; }
  .btn-plain{
    background:none; border:none;
    color:var(--ink-soft); font-size:13.5px; font-weight:600;
    text-decoration:underline; text-underline-offset:2px;
    white-space:nowrap; padding:0;
  }
  .btn-plain:hover{ color:var(--chili); }
  .btn-add{
    background:var(--ink);
    color:var(--bg-card);
    border:none;
    padding:10px 18px;
    border-radius:999px;
    font-size:13.5px; font-weight:700;
    white-space:nowrap;
    transition:background .15s ease;
  }
  .btn-add:hover{ background:var(--chili); }

  /* ---------- Overlay / modal shared ---------- */
  .overlay{
    position:fixed; inset:0; background:rgba(27,42,34,0.55);
    display:none; align-items:flex-start; justify-content:center;
    padding:40px 18px; overflow-y:auto; z-index:50;
  }
  .overlay.open{ display:flex; }
  .modal{
    background:var(--bg-card);
    max-width:480px; width:100%;
    border-radius:6px;
    padding:0;
    margin-top:20px;
  }
  .modal-head{
    padding:24px 26px 16px;
    border-bottom:1px solid var(--line);
  }
  .modal-head .modal-rest{ font-size:12.5px; color:var(--ink-soft); font-weight:600; text-transform:uppercase; letter-spacing:.04em;}
  .modal-head h3{ font-size:21px; margin-top:4px; }
  .modal-head .dish-desc{ margin-top:6px; max-width:none; }
  .modal-body{ padding:20px 26px; }
  .modal-foot{
    padding:18px 26px 24px;
    border-top:1px solid var(--line);
  }
  .opt-group{ margin-bottom:22px; }
  .opt-group:last-child{ margin-bottom:0; }
  .opt-title{ font-size:13.5px; font-weight:700; margin-bottom:10px; }
  .opt-title .opt-hint{ font-weight:500; color:var(--ink-soft); font-style:italic; }
  .opt-row{
    display:flex; align-items:center; justify-content:space-between;
    padding:10px 12px;
    border:1px solid var(--line);
    border-radius:4px;
    margin-bottom:8px;
    cursor:pointer;
    font-size:14.5px;
    transition:border-color .12s ease, background .12s ease;
  }
  .opt-row:last-child{ margin-bottom:0; }
  .opt-row:hover{ border-color:var(--mustard); }
  .opt-row.selected{ border-color:var(--chili); background:rgba(193,64,31,0.06); }
  .opt-row-left{ display:flex; align-items:center; gap:10px; }
  .opt-mark{
    width:16px; height:16px; border:1.5px solid var(--ink-soft); flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
  }
  .opt-mark.round{ border-radius:50%; }
  .opt-mark.square{ border-radius:3px; }
  .opt-row.selected .opt-mark{ border-color:var(--chili); }
  .opt-mark.round.on::after{ content:''; width:8px; height:8px; border-radius:50%; background:var(--chili); }
  .opt-mark.square.on::after{ content:''; width:9px; height:9px; border-radius:1px; background:var(--chili); }
  .opt-delta{ color:var(--ink-soft); font-size:13.5px; font-weight:600; }
  .opt-row.selected .opt-delta{ color:var(--chili-dark); }

  textarea.notes{
    width:100%; border:1px solid var(--line); border-radius:4px;
    padding:11px 13px; font-family:inherit; font-size:14.5px;
    resize:vertical; min-height:64px; background:transparent; color:var(--ink);
  }
  textarea.notes:focus{ outline:none; border-color:var(--chili); }

  .qty-row{ display:flex; align-items:center; justify-content:space-between; }
  .stepper{ display:flex; align-items:center; gap:14px; }
  .step-btn{
    width:30px; height:30px; border-radius:50%;
    border:1px solid var(--ink); background:transparent;
    font-size:16px; font-weight:700; line-height:1;
    display:flex; align-items:center; justify-content:center;
  }
  .step-btn:hover{ border-color:var(--chili); color:var(--chili); }
  .step-val{ font-weight:700; font-size:15px; min-width:16px; text-align:center; }

  .btn-primary{
    width:100%; background:var(--chili); color:var(--chalk);
    border:none; border-radius:999px; padding:14px 18px;
    font-size:15px; font-weight:700;
    display:flex; align-items:center; justify-content:space-between;
    transition:background .15s ease;
  }
  .btn-primary:hover{ background:var(--chili-dark); }
  .modal-close{
    position:absolute; top:16px; right:18px;
    background:none; border:none; font-size:20px; color:var(--ink-soft);
    width:28px; height:28px;
  }
  .modal{ position:relative; }

  /* ---------- Cart drawer ---------- */
  .drawer-overlay{
    position:fixed; inset:0; background:rgba(27,42,34,0.45);
    display:none; z-index:60;
  }
  .drawer-overlay.open{ display:block; }
  .drawer{
    position:fixed; top:0; right:0; height:100%;
    width:400px; max-width:92vw;
    background:var(--bg-card);
    box-shadow:-6px 0 24px rgba(0,0,0,0.18);
    display:flex; flex-direction:column;
    transform:translateX(100%);
    transition:transform .22s ease;
    z-index:61;
  }
  .drawer.open{ transform:translateX(0); }
  .drawer-head{
    padding:20px 24px; border-bottom:1px solid var(--line);
    display:flex; align-items:center; justify-content:space-between;
  }
  .drawer-head h3{ font-size:19px; }
  .drawer-body{ flex:1; overflow-y:auto; padding:6px 24px; }
  .cart-empty{ padding:60px 10px; text-align:center; color:var(--ink-soft); font-size:14.5px; }
  .cart-item{ padding:16px 0; border-bottom:1px solid var(--line); }
  .cart-item-top{ display:flex; justify-content:space-between; gap:12px; }
  .ci-name{ font-weight:700; font-size:15px; font-family:'Bricolage Grotesque', sans-serif; }
  .ci-rest{ font-size:12px; color:var(--ink-soft); margin-top:1px; }
  .ci-opts{ font-size:13px; color:var(--ink-soft); margin-top:6px; line-height:1.5; }
  .ci-notes{ font-size:13px; color:var(--chili-dark); font-style:italic; margin-top:4px; }
  .ci-bottom{ display:flex; align-items:center; justify-content:space-between; margin-top:12px; }
  .ci-remove{ background:none; border:none; font-size:12.5px; color:var(--ink-soft); text-decoration:underline; padding:0; }
  .ci-remove:hover{ color:var(--chili); }
  .ci-price{ font-weight:700; font-size:14.5px; }
  .drawer-foot{ border-top:1px solid var(--line); padding:18px 24px 22px; }
  .totals-row{ display:flex; justify-content:space-between; font-size:14.5px; margin-bottom:8px; color:var(--ink-soft); }
  .totals-row.grand{ color:var(--ink); font-weight:700; font-size:16.5px; margin-top:10px; border-top:1px solid var(--line); padding-top:12px; }

  .confirm-box{ padding:40px 26px; text-align:center; }
  .confirm-mark{
    width:52px; height:52px; border-radius:50%; background:var(--chili);
    color:var(--chalk); display:flex; align-items:center; justify-content:center;
    font-size:24px; margin:0 auto 18px;
  }
  .confirm-box h3{ font-size:20px; margin-bottom:8px; }
  .confirm-box p{ color:var(--ink-soft); font-size:14.5px; max-width:280px; margin:0 auto; }
  .btn-secondary{
    margin-top:22px; background:transparent; border:1px solid var(--ink);
    padding:11px 20px; border-radius:999px; font-size:14px; font-weight:600;
  }
  .btn-secondary:hover{ border-color:var(--chili); color:var(--chili); }

  footer{ padding:36px 0 50px; text-align:center; color:var(--ink-soft); font-size:13px; }

  .nav-actions{display:flex;align-items:center;gap:10px}
  .nav-link{background:none;border:none;color:var(--chalk-soft);font-size:13.5px;font-weight:600;text-decoration:underline;text-underline-offset:3px}
  .nav-link:hover{color:var(--mustard)}
  .badge{display:inline-block;background:var(--mustard);color:var(--ink);font-size:10.5px;font-weight:700;padding:1px 7px;border-radius:999px;margin-left:6px;vertical-align:middle;font-family:'Public Sans',sans-serif}
  .value-strip{background:var(--bg-card);border-bottom:1px solid var(--line)}
  .value-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:22px;padding:26px 0}
  .value-item b{font-family:'Bricolage Grotesque',sans-serif;font-size:19px;display:block;color:var(--chili-dark)}
  .value-item span{font-size:13.5px;color:var(--ink-soft)}
  .pay-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:6px}
  .pay-chip{border:1px solid var(--line);background:transparent;border-radius:999px;padding:7px 14px;font-size:13.5px;font-weight:600;color:var(--ink)}
  .pay-chip.on{border-color:var(--chili);background:rgba(193,64,31,.08);color:var(--chili-dark)}
  .panel-box{border:1px solid var(--line);background:var(--bg-card);padding:20px;margin-bottom:22px}
  .panel-box h3{font-size:18px;margin-bottom:12px}
  .fld{display:block;margin-bottom:12px;font-size:13px;font-weight:700}
  .fld small{font-weight:400;color:var(--ink-soft)}
  .fld input,.fld select,.fld textarea,.sel{display:block;width:100%;margin-top:5px;border:1px solid var(--line);border-radius:4px;padding:9px 11px;font:inherit;font-size:14.5px;background:#fff;color:var(--ink)}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .order-card{border-top:1px solid var(--line);padding:14px 0;font-size:14px}
  .order-card:first-of-type{border-top:none}
  .pill{display:inline-block;font-size:12px;font-weight:700;padding:2px 10px;border-radius:999px;background:var(--mustard);color:var(--ink)}
  .pill.s1{background:#E8C26A}.pill.s2{background:#4A7A2F;color:#fff}
  .sum-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:6px}
  .sum-grid div{font-size:12.5px;color:var(--ink-soft)}.sum-grid b{display:block;font-size:18px;color:var(--ink);font-family:'Bricolage Grotesque',sans-serif}
  header.topbar{padding-top:env(safe-area-inset-top,0px)}
</style>
</head>
<body>

<header class="topbar">
  <div class="wrap topbar-inner">
    <div class="logo" onclick="goHome()">
      <span class="display">MenuFlex</span>
      <span class="tag">tu menú, a tu manera</span>
    </div>
    <div class="nav-actions"><button class="nav-link" onclick="openPanel()">Soy restaurante</button><button class="cart-btn" onclick="openCart()">
      Tu pedido
      <span class="cart-badge" id="cartCount">0</span>
    </button></div>
  </div>
</header>

<div id="app"></div>

<footer>MenuFlex — proyecto de demostración. Los pedidos no se procesan realmente.</footer>

<!-- Customize modal -->
<div class="overlay" id="customizeOverlay">
  <div class="modal" id="customizeModal"></div>
</div>

<!-- Restaurant-switch confirm modal -->
<div class="overlay" id="switchOverlay">
  <div class="modal">
    <div class="modal-head">
      <div class="modal-rest">Un momento</div>
      <h3 id="switchTitle">Ya tienes platos de otro restaurante</h3>
      <p class="dish-desc" id="switchBody"></p>
    </div>
    <div class="modal-foot" style="display:flex; gap:10px;">
      <button class="btn-secondary" style="flex:1; margin-top:0;" onclick="closeSwitch()">Cancelar</button>
      <button class="btn-primary" style="flex:1;" onclick="confirmSwitch()"><span style="width:100%; text-align:center;">Vaciar y continuar</span></button>
    </div>
  </div>
</div>

<!-- Cart drawer -->
<div class="drawer-overlay" id="drawerOverlay" onclick="closeCart()"></div>
<div class="drawer" id="drawer">
  <div class="drawer-head">
    <h3>Tu pedido</h3>
    <button class="modal-close" style="position:static;" onclick="closeCart()">✕</button>
  </div>
  <div class="drawer-body" id="drawerBody"></div>
  <div class="drawer-foot" id="drawerFoot"></div>
</div>

<script>
/* ---------------- Data ---------------- */
const CUISINE_COLORS = {
  'Criolla':'#C1401F',
  'Cevichería':'#1B6E7A',
  'Saludable':'#4A7A2F',
  'Chifa':'#B8562E',
  'Menú del día':'#7A5C12'
};

const RESTAURANTS = [
  {
    id:'fogon', name:'El Fogón de la Esquina', cuisine:'Criolla', rating:4.7, time:'30-40 min',
    pickupPoints:[
      {id:'p1', label:'Jr. de la Unión 350, Cercado de Lima'},
      {id:'p2', label:'Av. Larco 1220, Miraflores'}
    ],
    dishes:[
      {id:'lomo', cat:'Platos fuertes', name:'Lomo Saltado', remove:['Cebolla','Tomate','Ají amarillo'], swap:parseOpts('Arroz blanco=0, Papas al horno=0, Ensalada fresca=1','s'), desc:'Trozos de res salteados con cebolla, tomate y papas fritas, servido con arroz.', price:24,
        sizes:[{id:'ind', label:'Individual', delta:0}, {id:'comp', label:'Para compartir (2 personas)', delta:18}],
        extras:[{id:'papa', label:'Extra papas fritas', delta:4}, {id:'arroz', label:'Extra arroz', delta:3}, {id:'huevo', label:'Huevo frito', delta:3}, {id:'carne', label:'Doble carne', delta:9}]},
      {id:'aji', cat:'Platos fuertes', name:'Ají de Gallina', remove:['Aceituna','Huevo duro'], swap:parseOpts('Arroz blanco=0, Papas sancochadas=0','s'), desc:'Pollo deshilachado en crema de ají amarillo, con arroz y aceituna.', price:20,
        extras:[{id:'crema', label:'Extra crema de ají', delta:3}, {id:'papa', label:'Papa extra', delta:3}, {id:'suave', label:'Versión sin picante', delta:0}]},
      {id:'causa', cat:'Platos fuertes', name:'Causa Limeña Rellena', desc:'Capas de papa amarilla sazonada con limón y ají, con el relleno que elijas.', price:16,
        sizes:[{id:'pollo', label:'Relleno de pollo', delta:0}, {id:'atun', label:'Relleno de atún', delta:2}, {id:'palta', label:'Relleno de palta (vegetariana)', delta:1}],
        extras:[{id:'extra_rel', label:'Porción extra de relleno', delta:4}]},
